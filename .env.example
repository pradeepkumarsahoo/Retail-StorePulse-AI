# StorePulse-AI local configuration (placeholders only — no real secrets)
STOREPULSE_DB_URL=sqlite:///./storepulse.sqlite
STOREPULSE_SYNTHETIC_SEED=42
STOREPULSE_LOG_LEVEL=INFO
# TMS (Transport Management System) integration — how many days ahead the
# inbound-truck lookahead and labor-plan check may read. Business rule: 5.
STOREPULSE_TMS_HORIZON_DAYS=5
